{
    "name": "histel951/dota-2-api",
    "description": "Dota 2 API client for OpenDota and STRATZ",
    "type": "symfony-bundle",
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        },
        "symfony": {
            "allow-contrib": true,
            "require": "6.4.*|7.0.*"
        }
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Histel951\\Dota2Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Histel951\\Dota2Api\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Histel951",
            "email": "histel951@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "symfony/http-client": "^6.4|^7.0",
        "symfony/http-client-contracts": "^3.0",
        "symfony/http-kernel": "^6.4|^7.0",
        "symfony/config": "^6.4|^7.0",
        "symfony/dependency-injection": "^6.4|^7.0"

    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/phpunit-bridge": "^6.4|^7.0",
        "symfony/framework-bundle": "^6.4|^7.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
